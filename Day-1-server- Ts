import { Router, Request, Response } from "express";

const router = Router();

// GET /tasks
router.get("/", (req: Request, res: Response) => {
  res.status(200).json({
    success: true,
    message: "Fetched all tasks",
    data: [
      {
        id: 1,
        title: "Learn TypeScript",
        completed: false,
      },
      {
        id: 2,
        title: "Build Express API",
        completed: true,
      },
    ],
  });
});

// GET /tasks/:id
router.get("/:id", (req: Request, res: Response) => {
  const { id } = req.params;

  res.status(200).json({
    success: true,
    message: `Fetched task ${id}`,
    data: {
      id,
      title: "Sample Task",
      completed: false,
    },
  });
});

// POST /tasks
router.post("/", (req: Request, res: Response) => {
  const { title } = req.body;

  res.status(201).json({
    success: true,
    message: "Task created successfully",
    data: {
      id: Date.now(),
      title,
      completed: false,
    },
  });
});

export default router;
